{
  "name": "usestack",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx,.mjs . --max-warnings=0",
    "start": "next start",
    "test": "node --test tests/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:deps": "npm audit --omit=dev --audit-level=high",
    "catalog:visibility": "node scripts/generate-catalog-visibility.mjs",
    "catalog:reaudit:strict": "node scripts/reaudit-catalog-strict.mjs && node scripts/generate-catalog-visibility.mjs outputs/catalog-audit-2026-07-09/strict-audit.json lib/catalog-visibility.generated.mjs",
    "brand:assets": "node scripts/render-brand-assets.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run security:secrets",
    "ci": "npm run check && npm run build"
  },
